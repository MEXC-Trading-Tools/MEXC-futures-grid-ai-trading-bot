# MEXC API credentials (https://www.mexc.com/user/openapi)
# Requires futures order permissions + completed KYC. Disable withdrawals on the key.
MEXC_API_KEY=your_api_key
MEXC_SECRET_KEY=your_secret_key

# Contract — liquid majors only. BTC-USDT / btc_usdt also accepted.
MEXC_SYMBOL=BTC_USDT

# Geometric = equal % steps (crypto returns are multiplicative; cycle PnL stays more uniform on BTC perps).
# Arithmetic = equal dollar steps. Prefer geometric on BTC_USDT.
GRID_MODE=geometric

# Fitted around a ~$64.3k BTC_USDT perp print so geometric mid sits inside the band with room on both sides.
# Re-fit these two numbers whenever last has walked; AI can only tighten (0.9×–1.1× of this base), not rescue a stale band.
GRID_LOWER_PRICE=58500
GRID_UPPER_PRICE=70800

# 8 rungs (working range 6–10). Fewer levels ⇒ wider % spacing ⇒ round-trip still clears maker/taker + slip + funding drag.
GRID_LEVELS=8

# Contracts per rung (NOT BTC). BTC_USDT contractSize is typically 0.0001 BTC, so 100 contracts ≈ 0.01 BTC ≈ $643 notional at $64.3k.
GRID_ORDER_SIZE=100

# Futures settings. 6x is grid-sane: a range walk should not become a margin event. Isolated keeps the blast radius on this symbol.
LEVERAGE=6
MARGIN_MODE=isolated
POSITION_MODE=one-way

# Long starter with a BTC-up bias. Keep AI_ENABLED=true so regime can flip to short / neutral. Do not run a silent long book with AI off.
GRID_DIRECTION=long

# AI regime loop (RSI / ATR / Bollinger / vol / trend → bounded nudges). 5 min is REST-friendly vs stale regime.
AI_ENABLED=true
AI_REBALANCE_INTERVAL_MS=300000

# Margin cap must cover the open-side ladder walk (~$740 at 6x / 100 contracts) without blocking every open, and still ceiling a $10k starter desk.
MAX_MARGIN_EXPOSURE=2000

# Trend brakes: shut the desk down if last walks off the band (stranded leveraged inventory).
STOP_LOSS_PRICE=56800
TAKE_PROFIT_PRICE=72800

# Funding brake. |funding| > this blocks boot (and logs a poll warning). 0.0008 can actually fire on crowded MEXC perps; 0.001 is what the AI detector already treats as hostile to a long grid.
MAX_FUNDING_RATE=0.0008

# Poll / sync interval. 3–5s is enough for a limit grid; faster burns REST weight, not edge.
POLL_INTERVAL_MS=5000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
