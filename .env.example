# MEXC API credentials (https://www.mexc.com/user/openapi)
# Requires futures order permissions + completed KYC
MEXC_API_KEY=your_api_key
MEXC_SECRET_KEY=your_secret_key

# Contract symbol, e.g. BTC_USDT or BTC-USDT (both accepted)
MEXC_SYMBOL=BTC_USDT

# Grid strategy: arithmetic | geometric
GRID_MODE=arithmetic

# Price range for the grid (USDT price)
GRID_LOWER_PRICE=74000
GRID_UPPER_PRICE=81000
GRID_LEVELS=12

# Contracts per grid level (see contract detail minVol)
GRID_ORDER_SIZE=10

# Futures settings
LEVERAGE=10
MARGIN_MODE=isolated
POSITION_MODE=one-way
GRID_DIRECTION=long

# AI adaptive optimization (true | false)
AI_ENABLED=true
AI_REBALANCE_INTERVAL_MS=300000

# Optional risk limits
MAX_MARGIN_EXPOSURE=500
# STOP_LOSS_PRICE=72000
# TAKE_PROFIT_PRICE=83000
# MAX_FUNDING_RATE=0.001

# Polling interval in ms
POLL_INTERVAL_MS=5000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
